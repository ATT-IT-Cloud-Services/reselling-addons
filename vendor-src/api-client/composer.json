{
  "name": "ignite/api-client",
  "description": "Official ignite API client",
  "version": "0.2.0",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "ext-json": "*",
    "guzzlehttp/guzzle": "^7.9"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "Ignite\\ApiClient\\": "src/"
    },
    "classmap": [
      "src/Models/"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Ignite\\ApiClient\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
